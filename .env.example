# Provider priority in AUTO mode (optional)
AI_PROVIDER_ORDER=gemini,openai,claude,ollamaCloud,ollamaLocal

# Request timeout in milliseconds (optional)
AI_REQUEST_TIMEOUT_MS=30000

# OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODELS=claude-3-5-sonnet-latest,claude-3-5-haiku-latest

# Ollama Cloud
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=
OLLAMA_CLOUD_MODELS=

# Ollama Local
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_MODELS=llama3.2
